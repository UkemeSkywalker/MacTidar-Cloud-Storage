# Copy to .env.local for local development. Values come from `terraform output`.
DATA_REGION=af-south-1
TABLE_NAME=mactidar
FILES_BUCKET=mactidar-files-<account-id>
COGNITO_USER_POOL_ID=af-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
SES_FROM_EMAIL=no-reply@cloud.mactidar.com
SSM_PREFIX=/mactidar
APP_URL=http://localhost:3000
