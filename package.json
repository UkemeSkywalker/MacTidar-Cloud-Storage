{
  "name": "mactidar-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-invite": "node --env-file=.env.local --conditions=react-server --import tsx scripts/create-invite.ts",
    "build:workers": "esbuild infra/modules/workers/zip/zip-folder.mjs --bundle --platform=node --target=node22 --format=esm --external:@aws-sdk/client-s3 --external:@aws-sdk/client-dynamodb --external:@aws-sdk/lib-dynamodb --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --legal-comments=none --outfile=infra/modules/workers/src/zip-folder.mjs",
    "migrate:workspaces": "node --env-file=.env.local --conditions=react-server --import tsx scripts/migrate-workspaces.ts",
    "recompute:usage": "node --env-file=.env.local --conditions=react-server --import tsx scripts/recompute-usage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yazl": "^3.3.1"
  }
}
